<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>土土协作</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; background: #f5f5f5; min-height: 100vh; padding: 12px; }
  .container { max-width: 360px; margin: 0 auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
  .header { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); padding: 16px; text-align: center; color: #fff; }
  .header h1 { font-size: 20px; font-weight: 600; }
  .menu { padding: 12px; }
  .menu-item { display: block; padding: 14px 16px; margin-bottom: 8px; background: #fafafa; border-radius: 8px; cursor: pointer; border: 1px solid #e8e8e8; touch-action: manipulation; }
  .menu-item:active { background: #e8e8e8; }
  .menu-row { display: flex; align-items: center; }
  .menu-icon { width: 32px; height: 32px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 16px; margin-right: 12px; color: #fff; flex-shrink: 0; }
  .icon-sample { background: #667eea; }
  .icon-cargo { background: #f5576c; }
  .icon-payment { background: #4facfe; }
  .icon-calc { background: #43e97b; }
  .icon-cloud { background: #fa8c16; }
  .menu-text { flex: 1; font-size: 15px; font-weight: 500; }
  .menu-arrow { color: #ccc; font-size: 18px; }
  .footer { text-align: center; padding: 10px; background: #fafafa; border-top: 1px solid #e8e8e8; font-size: 11px; color: #999; }
</style>
</head>
<body>
<div class="container" id="app">
  <div class="header"><h1>土土协作</h1></div>
  <div class="menu">
    <div class="menu-item" onclick="loadTool(\'sample\')"><div class="menu-row"><div class="menu-icon icon-sample">📋</div><div class="menu-text">样布报单</div><div class="menu-arrow">›</div></div></div>
    <div class="menu-item" onclick="loadTool(\'v50\')"><div class="menu-row"><div class="menu-icon icon-cargo"></div><div class="menu-text">大货报单</div><div class="menu-arrow">›</div></div></div>
    <div class="menu-item" onclick="loadTool(\'customer-payment\')"><div class="menu-row"><div class="menu-icon icon-payment">💰</div><div class="menu-text">客户公账</div><div class="menu-arrow">›</div></div></div>
    <div class="menu-item" onclick="loadTool(\'payment-collection\')"><div class="menu-row"><div class="menu-icon icon-calc">📊</div><div class="menu-text">收款记录</div><div class="menu-arrow">›</div></div></div>
    <div class="menu-item" onclick="loadTool(\'tutu-cloud\')"><div class="menu-row"><div class="menu-icon icon-cloud">️</div><div class="menu-text">土土云同步</div><div class="menu-arrow">›</div></div></div>
    <div class="menu-item" onclick="location.href='pursuit.html'"><div class="menu-row"><div class="menu-icon" style="background:#e74c3c">🔥</div><div class="menu-text">微信追击</div><div class="menu-arrow">›</div></div></div>
  </div>
  <div class="footer">土土协作 · 友谊纺织</div>
</div>
<script>
var TOOL_v50={s:atob(''),b:atob(''),c:[atob(''),atob(''),atob(''),atob(''),atob(''),atob('ZnVuY3Rpb24gZ29Ib21lKCkgewogIGlmIChsb2NhdGlvbi5ob3N0bmFtZSA9PT0gJ2xvY2FsaG9zdCcgfHwgbG9jYXRpb24uaG9zdG5hbWUgPT09ICcxMjcuMC4wLjEnKSB7CiAgICB3aW5kb3cubG9jYXRpb24uaHJlZiA9ICcvJzsKICB9IGVsc2UgewogICAgd2luZG93LmxvY2F0aW9uLmhyZWYgPSAnaW5kZXguaHRtbCc7CiAgfQp9'),atob(''),atob('')]};
var TOOL_sample_report={s:atob(''),b:atob(''),c:[atob(''),atob(''),atob(''),atob('ZmV0Y2goImh0dHBzOi8vZ2l0ZWUuY29tL3lvdXlpMDA4L2ZyaWVuZHNoaXAtdG9vbC9yYXcvbWFzdGVyL3Byb2R1Y3QtZGF0YS5qc29uIikudGhlbihyPT5yLmpzb24oKSkudGhlbihkPT57UFJPRFVDVF9EQj1kO2NvbnNvbGUubG9nKCLkuqflk4HmlbDmja7liqDovb3lrozmiJAiKTt9KS5jYXRjaChlPT5jb25zb2xlLmVycm9yKCLliqDovb3kuqflk4HmlbDmja7lpLHotKUiLGUpKTs='),atob('ZmV0Y2goImh0dHBzOi8vZ2l0ZWUuY29tL3lvdXlpMDA4L2ZyaWVuZHNoaXAtdG9vbC9yYXcvbWFzdGVyL2NvbG9yLWRhdGEuanNvbiIpLnRoZW4ocj0+ci5qc29uKCkpLnRoZW4oZD0+e0NPTE9SX0FMSUFTX01BUD1kO2NvbnNvbGUubG9nKCLpopzoibLmlbDmja7liqDovb3lrozmiJAiKTt9KS5jYXRjaChlPT5jb25zb2xlLmVycm9yKCLliqDovb3popzoibLmlbDmja7lpLHotKUiLGUpKTs='),atob(''),atob('')]};
var TOOL_customer_payment={s:atob(''),b:atob(''),c:[atob('')]};
var TOOL_payment_collection={s:atob(''),b:atob(''),c:[atob('')]};
var TOOL_tutu_cloud={s:atob(''),b:atob(''),c:[]};

function loadTool(name) {
  var t = window['TOOL_' + name.replace(/-/g, '_')];
  if (!t) { alert('工具未找到'); return; }
  document.open('text/html');
  var s = document.createElement('style');
  s.textContent = t.s;
  document.head.appendChild(s);
  document.write(t.b);
  for (var i = 0; i < t.c.length; i++) {
    document.write('<scr' + 'ipt>' + t.c[i] + '</scr' + 'ipt>');
  }
  document.close();
}
</script>
</body>
</html>